# DontKillMyApp - universal system.prop (resetprop override, OEM-agnostic)
# Copyright (C) 2026 @itswill00
# NOTE: post-fs-data.sh is the real source of truth (OEM-gated).
# This file only covers universal LMKD + phantom flags so service.sh fallback works on Zygoted devices.
# Xiaomi-only props are applied conditionally in post-fs-data.sh, not here - keeping boot safe on OneUI/XOS/ColorOS.

# Universal: relax LMKD PSI thresholds (all devices)
ro.lmk.psi_partial_stall_ms=250
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.kill_timeout_ms=250
persist.device_config.lmkd_native.thrashing_limit_critical=600

# Universal: phantom monitor (AOSP 12+)
persist.sys.fflag.override.settings_enable_monitor_phantom_procs=false
